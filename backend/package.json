{
  "name": "@my-fin/backend",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "prebuild": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/server.js",
    "db:migrate": "tsx database/migrate.ts",
    "test": "tsx --test database/transaction.test.ts src/lib/pluggy-client.test.ts src/modules/transaction/transaction-service.test.ts src/modules/purchase-limit/purchase-limit-service.test.ts src/modules/open-finance/open-finance-service.test.ts src/modules/account/account-service.test.ts src/modules/fixed-income/fixed-income-service.test.ts src/modules/variable-income/variable-income-service.test.ts src/modules/payment/payment-service.test.ts src/modules/yield/yield-service.test.ts",
    "lint": "oxlint src database"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "pg": "^8.16.3"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.5",
    "node-pg-migrate": "^9.0.0",
    "oxlint": "^1.81.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
